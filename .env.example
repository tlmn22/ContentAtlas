# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=

# TMDB (https://www.themoviedb.org/settings/api - API Read Access Token, v4)
TMDB_API_TOKEN=

# Cron endpoint secret (random string; GitHub Actions / Vercel Cron sends it as Bearer token)
CRON_SECRET=

# /admin login: accounts live in the admin_users table (see supabase/migrations),
# manageable from /admin itself. This secret only signs session cookies -
# random string, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=

# Canonical site URL for SEO / Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
